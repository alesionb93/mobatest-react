# Copie este arquivo para .env e preencha com as credenciais do projeto Supabase.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# SSO Soluções (WA) — autenticação corporativa, ponte enquanto o Keycloak não está pronto.
VITE_WA_AUTH_BASE_URL_SOLUCOES=
VITE_MOBATO_AUTH_FLOW_TOKEN=

# Base da API nova (Spring Boot) — usada pelo endpoint /me e futuras chamadas.
VITE_BASE_URL=http://localhost:8080
